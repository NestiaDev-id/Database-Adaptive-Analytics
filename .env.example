# ==========================================
# DB Analyst AI - Full Configuration Template
# Salin file ini menjadi ".env" lalu isi nilai yang sesuai.
# ==========================================

# ------------------------------------------
# 1. AI PROVIDER API KEYS
# (Wajib isi minimal satu agar AI bisa menjawab)
# ------------------------------------------

# [Google Gemini] - Gratis & Cepat (Rekomendasi Utama)
# Link: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# [Groq] - Super Cepat (Llama 3)
# Link: https://console.groq.com/keys
GROQ_API_KEY=

# [Mistral AI] - Model Eropa yang Kuat
# Link: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# [OpenAI] - GPT-4 (Berbayar)
# Link: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [DeepSeek] - Alternatif Hemat
# Link: https://platform.deepseek.com/
# Link: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# [Cerebras] - High Performance AI
# Link: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=


# ------------------------------------------
# 2. DATABASE CONNECTION (FALLBACK / SEEDER)
# Digunakan oleh 'database_seeder.py' atau jika frontend tidak mengirim detail koneksi.
# ------------------------------------------

# Pilih Tipe Database: PostgreSQL, MySQL, SQL Server, SQLite, Oracle, Snowflake, BigQuery, MongoDB
DB_TYPE=PostgreSQL

# --- OPSI A: CLOUD DATABASE (Rekomendasi Modern) ---
# Gunakan ini untuk Supabase, Neon, MongoDB Atlas, CockroachDB, dll.
# Format: protocol://user:password@host:port/database
# Contoh Supabase: postgresql://postgres:mypassword@db.xyz.supabase.co:5432/postgres
# Contoh MongoDB:  mongodb+srv://myuser:mypassword@cluster0.abc.mongodb.net/my_database
DB_URI=

# --- OPSI B: LOCAL / TRADITIONAL HOST ---
# Gunakan ini jika database ada di localhost (XAMPP/Docker) dan tidak punya URI panjang.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=db_analyst_test

# [Catatan Khusus]
# SQLite: Isi DB_HOST dengan path file absolut/relatif (misal: ./test.db). DB_USER/PASS kosongkan.
# BigQuery: Isi DB_PASS dengan konten JSON Service Account (bukan path file).


# ------------------------------------------
# 3. APPLICATION SETTINGS
# ------------------------------------------

# Mode Debug (Menampilkan log lebih detail di terminal)
DEBUG=true

# Model Default yang dipilih saat aplikasi dibuka pertama kali
# Pilihan: "Gemini (Google)", "Groq (Llama 3)", "Mistral AI", "GPT-4 (OpenAI)", "DeepSeek"
DEFAULT_MODEL="Gemini (Google)"

# (Advanced) Override Model Name untuk Provider Tertentu
# Default sistem sudah memilih model terbaik, tapi Anda bisa mengubahnya di sini jika perlu.
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# MISTRAL_MODEL=mistral-large-latest
